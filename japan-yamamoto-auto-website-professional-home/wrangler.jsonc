{
  "name": "sample",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yamamoto-auto-db",
      "database_id": "ebd61331-322e-4aa0-983d-63ee9e201dd7",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "yamamoto-auto-images"
    }
  ]
}
